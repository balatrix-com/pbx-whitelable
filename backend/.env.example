# Database
DB_HOST=10.10.0.124
DB_PORT=5432
DB_USER=subadmin
DB_PASSWORD=your_db_password
DB_NAME=subtest
DATABASE_URL="postgresql://subadmin:your_db_password@10.10.0.124:5432/subtest?schema=public"

# Read-only connection to bala_billing.live_call_event (not the Prisma database).
SIP_TRACE_DATABASE_URL="postgresql://sip_trace_reader:change_me@127.0.0.1:5432/bala_billing"
# Native Homer coordinator on this host; configure its actual URL/token privately.
HOMER_API_BASE_URL="http://127.0.0.1:9088"
HOMER_API_TOKEN="change_me"

# Redis
REDIS_HOST=10.10.0.124
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# App
PORT=3000
# Backend always binds to 127.0.0.1; expose it through Nginx only.
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# FreeSWITCH Database
FS_DB_HOST=10.10.0.124
FS_DB_PORT=5432
FS_DB_NAME=freeswitch
FS_DB_USER=freeswitch
FS_DB_PASSWORD=your_fs_password

# VoIP config
KAMAILIO_DB_NAME=kamailio
KAMAILIO_RPC_URL=http://10.10.0.124:8080/rpc
SIP_REALM=demowlable.balatrix.com
SIP_SERVER=10.10.0.124:5070

# Audio Server
FS_AUDIO_HOST=localhost
FS_AUDIO_USER=soxuser
FS_AUDIO_PASSWORD=soxuser
FS_AUDIO_BASE_PATH=/opt/ivr_audio
AUDIO_SYSTEM_PATH=/opt/ivr_audio/system
AUDIO_INVALID=/opt/ivr_audio/system/invalid_input.wav
AUDIO_UNAVAILABLE=/opt/ivr_audio/system/ext_unavailable.wav
AUDIO_NOINPUT=/opt/ivr_audio/system/ivr_no_input.wav

# Outbound
OUTBOUND_GATEWAY=10.10.0.124:5060

# APIs
BARGE_API_URL=http://10.10.0.124:8003
BARGE_API_KEY=your_barge_api_key

ZEPTOMAIL_API_KEY="Zoho-enczapikey..."
FRONTEND_URL="https://subdev.balatrix.com"
PBX_SYNC_TOKEN=your-sync-token

SUB_BILLING_API_URL=http://10.10.0.124:5005/api
PBX_SUB_BILLING_SERVICE_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
CACHE_FLUSH_URL=http://10.10.0.124:8000
CACHE_FLUSH_TOKEN=your_flush_token

BILLING_CACHE_REFRESH_URL=http://10.10.0.124:8005/api/v1/cache/refresh
BILLING_CACHE_REFRESH_TOKEN=dev-token-123

ANALYTICS_ENGINE_URL=http://10.10.0.124:8001

FS_RECORDING_HOST=10.10.0.124
FS_RECORDING_PORT=22
FS_RECORDING_USER=recordingadmin
FS_RECORDING_PASSWORD=your_recording_pwd
FS_RECORDING_BASE_PATH=/recordings
FS_RECORDING_PATH=/mnt/freeswitch-recordings/recordings

# Enterprise Limits
SYSTEM_LIMIT_EXTENSIONS=500
SYSTEM_LIMIT_IVRS=50
SYSTEM_LIMIT_SCHEDULERS=50
SYSTEM_LIMIT_RING_GROUPS=50
SYSTEM_LIMIT_DID_FORWARDS=50
SYSTEM_LIMIT_TFNS=50
SYSTEM_LIMIT_DIDS=50

# CORS Configuration
# MUST be set on every production server!
# Comma-separated list of exact domains allowed to access this backend. Do not include trailing slashes.
ALLOWED_ORIGINS="http://localhost:5173,https://your-production-domain.com"
