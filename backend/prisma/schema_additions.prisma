// 1. Transactional Integrity
model IdempotencyKey {
  key        String   @id
  method     String
  path       String
  params     Json
  response   Json     // Cache the successful response
  lockedAt   DateTime @default(now())
  @@map("idempotency_keys")
}

// 2. Pricing & Margins
model PricingBlueprint {
  id          String   @id @default(uuid())
  name        String
  components  Json     // [{ type, unit_price, cost_basis, min_margin, billing_cycle }]
  rules       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  quotes      Quote[]
  @@map("pricing_blueprints")
}

// 4. Financial Ledger (Immutable)
enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  VOID
  REFUNDED
  DISPUTED
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String?
  status          InvoiceStatus @default(DRAFT)
  
  total           Decimal
  balanceDue      Decimal
  
  // Adjustments & Audit
  adjustments     InvoiceAdjustment[]
  // ledgerEntries   LedgerEntry[]       // Double-entry bookkeeping if needed
  
  stripeId        String? @unique
  idempotencyKey  String? @unique     // Linked to Stripe PaymentIntent
  
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  quoteId     String?
  quote       Quote?        @relation(fields: [quoteId], references: [id])
  
  @@map("invoices")
}

model InvoiceAdjustment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  reason      String   // "SLA Breach", "Support Credit"
  amount      Decimal  // Negative for credit
  authorizedBy String
  createdAt   DateTime @default(now())
  @@map("invoice_adjustments")
}

// 5. Versioned Configuration (For Disputes)
model TenantConfigVersion {
  id          String   @id @default(uuid())
  tenantId    String
  version     Int
  
  // Full snapshot of services active at this time
  // { "dids": 5, "extensions": 20, "plan": "Pro" }
  configSnapshot Json
  
  effectiveFrom DateTime
  effectiveTo   DateTime?
  
  serviceOrderId String? // Traceability
  @@map("tenant_config_versions")
}
